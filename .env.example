# ==========================================
# Telegram Giveaway Platform - Environment Config
# ==========================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Telegram Bot Username (without @)
BOT_USERNAME=GiveawayHubBot

# 3. Administrator Telegram User IDs (comma-separated if multiple)
# Obtain your user ID by messaging @userinfobot or @raw_data_bot
ADMIN_IDS=123456789,987654321

# 4. Database Connection URL
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///giveaway_bot.db
# Production PostgreSQL (Railway / Render / VPS):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/giveaways

# 5. Operational Parameters
DEFAULT_REFERRAL_BONUS=1
DAILY_BONUS_ENTRIES=1
CLAIM_WINDOW_HOURS=24
RATE_LIMIT_DELAY=0.04
LOG_LEVEL=INFO

# 6. Community & Support
SUPPORT_URL=https://t.me/your_support_username
COMMUNITY_CHANNEL=@YourGiveawayChannel
